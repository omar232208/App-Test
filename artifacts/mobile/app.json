{
  "expo": {
    "name": "DevOS",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.devosoftware.devos"
    },
    "android": {
      "package": "com.devosoftware.devos",
      "backgroundColor": "#05050A"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "16e4fcde-e43a-4e0b-a75d-85daee6838d1"
      }
    },
    "owner": "omargomaa451"
  }
}
